# Local Todo demonstration only. These synthetic credentials are public defaults.
# CI and pnpm check do not use this file. Do not use these credentials in a deployment.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.6-luna
OPENAI_ALLOWED_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
CAES_AI_MODEL_PROFILE_DEFAULT=gpt-5.6-luna
CAES_AI_MODEL_PROFILE_FAST=gpt-5.6-luna
CAES_AI_MODEL_PROFILE_DEEP=gpt-5.6-terra
CAES_AI_MAX_REASONING_EFFORT=medium
DATABASE_URL=postgresql://caesai:caes-ai-local-password@localhost:54329/caesai
CAES_AI_PUBLIC_BASE_URL=http://localhost:4310
CAES_AI_CALLBACK_ISSUER=http://localhost:4310
CAES_AI_CALLBACK_SIGNING_KEYS_PATH=.data/callback-signing-keys.json
CAES_AI_ALLOW_INSECURE_CALLBACKS=true
CAES_AI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CAES_AI_TODO_GATEWAY_URL=http://localhost:5180/api/ai/tools/execute
TODO_APP_API_KEY=caesai_app_0123456789abcdef_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
CAES_AI_CONTEXT_SIGNING_KEY=caes-ai-local-context-signing-key-at-least-32-bytes
CaesAi__ApplicationId=todo-app
CaesAi__ApplicationApiKey=caesai_app_0123456789abcdef_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
CaesAi__ContextSigningKey=caes-ai-local-context-signing-key-at-least-32-bytes
CaesAi__ServerUrl=http://localhost:4310
CaesAi__CallbackIssuer=http://localhost:4310
CaesAi__DefaultReasoningEffort=none
CaesAi__MaximumReasoningEffort=none
CAES_AI_OTEL_ENABLED=false
